<Window x:Class="ZiiuApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZiiUScreen" Width="1040" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ZiiUScreen;component/Assets/ZIIUICON.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Margin="12,12,6,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,18">
                <Image Source="pack://application:,,,/ZiiUScreen;component/Assets/ZIIUICON.png" Width="36" Height="36"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ZiiUScreen" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Wii U GamePad for Windows" Style="{StaticResource TileLabel}" FontSize="11.5" />
                </StackPanel>
            </StackPanel>

            <!-- Compact live status, always visible -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10" Margin="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SideDot" Width="9" Height="9" Fill="{StaticResource IdleBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SideState" Text="Stopped" Margin="8,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="SidePad" Text="GamePad: —" Style="{StaticResource Hint}" Margin="17,3,0,0" />
                </StackPanel>
            </Border>

            <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Style="{StaticResource NavItem}" Tag="Dashboard">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;" FontSize="16" Width="28" VerticalAlignment="Center" /><TextBlock Text="Dashboard" /></StackPanel>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="Display">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" FontSize="16" Width="28" VerticalAlignment="Center" /><TextBlock Text="Display" /></StackPanel>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="Controller">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7FC;" FontSize="16" Width="28" VerticalAlignment="Center" /><TextBlock Text="Controller &amp; touch" /></StackPanel>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="Audio">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE767;" FontSize="16" Width="28" VerticalAlignment="Center" /><TextBlock Text="Audio" /></StackPanel>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="Advanced">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16" Width="28" VerticalAlignment="Center" /><TextBlock Text="Advanced" /></StackPanel>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="Logs">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F9;" FontSize="16" Width="28" VerticalAlignment="Center" /><TextBlock Text="Logs" /></StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- Pages -->
        <Grid Grid.Column="1">
            <!-- ============ Dashboard ============ -->
            <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,24,28,24" MaxWidth="980">
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />

                    <Border Style="{StaticResource Card}" Padding="22,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="52" Height="52" VerticalAlignment="Center">
                                <Ellipse x:Name="HeroRing" Fill="{StaticResource IdleBrush}" Opacity="0.18" />
                                <TextBlock x:Name="HeroIcon" FontFamily="{StaticResource IconFont}" Text="&#xE7FC;" FontSize="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource IdleBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeroState" Text="Stream stopped" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="HeroDetail" Text="Start the stream to put the desktop on the GamePad." Style="{StaticResource Hint}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StartButton" Click="Start_Click" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Padding="14,7">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,1,8,0" /><TextBlock Text="Start" /></StackPanel>
                                </Button>
                                <Button x:Name="StopButton" Click="Stop_Click" MinWidth="100" Padding="14,7" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" Margin="0,1,8,0" /><TextBlock Text="Stop" /></StackPanel>
                                </Button>
                                <Button x:Name="ResetButton" Click="Reset_Click" MinWidth="100" Padding="14,7" Margin="8,0,0,0"
                                        ToolTip="Stop and start again (same as Reset connection.cmd, with the app's settings)">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" Margin="0,1,8,0" /><TextBlock Text="Reset" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Message bar: errors, "restart to apply" -->
                    <Border x:Name="Banner" Visibility="Collapsed" CornerRadius="8" Padding="16,11" Margin="0,0,0,12" BorderThickness="1">
                        <DockPanel>
                            <Button x:Name="BannerAction" DockPanel.Dock="Right" Click="BannerAction_Click" Margin="12,0,0,0" Padding="12,4" Visibility="Collapsed" />
                            <Button DockPanel.Dock="Right" Click="BannerClose_Click" Padding="8,4" Margin="8,0,0,0" ToolTip="Dismiss">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="11" />
                            </Button>
                            <TextBlock x:Name="BannerIcon" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                            <StackPanel>
                                <TextBlock Text="GAMEPAD" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="PadValue" Text="—" Style="{StaticResource TileValue}" />
                                <TextBlock x:Name="PadDetail" Text="" Style="{StaticResource TileDetail}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                            <StackPanel>
                                <TextBlock Text="VIDEO" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="VideoValue" Text="—" Style="{StaticResource TileValue}" />
                                <TextBlock x:Name="VideoDetail" Text="" Style="{StaticResource TileDetail}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                            <StackPanel>
                                <TextBlock Text="CONTROLLER &amp; TOUCH" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="InputValue" Text="—" Style="{StaticResource TileValue}" />
                                <TextBlock x:Name="InputDetail" Text="" Style="{StaticResource TileDetail}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                            <StackPanel>
                                <TextBlock Text="AUDIO" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="AudioValue" Text="—" Style="{StaticResource TileValue}" />
                                <TextBlock x:Name="AudioDetail" Text="" Style="{StaticResource TileDetail}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Style="{StaticResource Hint}" Margin="2,4,0,0"
                               Text="Read from the stream's logs every second. Battery level, signal strength and end-to-end picture latency aren't measured yet, so they aren't shown." />
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Display ============ -->
            <ScrollViewer x:Name="PageDisplay" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,24,28,24" MaxWidth="980">
                    <TextBlock Text="Display" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Streamed display" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="The Windows display whose picture goes to the GamePad. Touch input lands on the same display. Normally the dummy plug (YOUR_DISPLAY_ID); choosing your main monitor mirrors it." />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="RefreshDisplays_Click" Margin="8,0,0,0" Padding="10,6" ToolTip="Refresh the list">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" />
                                </Button>
                                <ComboBox x:Name="DisplayBox" SelectionChanged="Setting_Changed" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="The GamePad's screen is 854×480 at 59.94 Hz; the display is scaled to fit it. A 16:9 display fills it best." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Encoder preset" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="x264 speed preset. Faster presets spend less time per frame; slower ones compress better. 'fast' is the tested default." />
                            <ComboBox x:Name="PresetBox" Width="220" HorizontalAlignment="Left" SelectionChanged="Setting_Changed" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="Changes apply the next time the stream starts (or on Reset)." Margin="2,0,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Controller ============ -->
            <ScrollViewer x:Name="PageController" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,24,28,24" MaxWidth="980">
                    <TextBlock Text="Controller &amp; touch" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Live tools" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="LiveHint" Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="These act on the running stream." />
                            <WrapPanel>
                                <Button x:Name="CalibrateButton" Click="Calibrate_Click" Padding="14,7" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C9;" Margin="0,1,8,0" /><TextBlock Text="Calibrate touch &amp; sticks" /></StackPanel>
                                </Button>
                                <Button x:Name="RumbleButton" Click="Rumble_Click" Padding="14,7" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE877;" Margin="0,1,8,0" /><TextBlock Text="Test rumble" /></StackPanel>
                                </Button>
                                <Button x:Name="IrOnButton" Click="IrOn_Click" Padding="14,7" Margin="0,0,8,8" Content="Sensor bar on" />
                                <Button x:Name="IrOffButton" Click="IrOff_Click" Padding="14,7" Margin="0,0,8,8" Content="Sensor bar off" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="On the GamePad: hold TV for 2 s to calibrate, short press TV to toggle the IR sensor bar (for a Wii Remote, e.g. in Dolphin). The sensor bar hasn't been checked with a Wii Remote yet. Calibration is saved to .local\input-calibration.txt." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Button layout" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="The GamePad appears to games as an Xbox 360 controller." />
                            <ComboBox x:Name="LayoutBox" SelectionChanged="Setting_Changed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Options at start" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="InvertYBox" Content="Invert both sticks' Y axis" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,4,0,6" />
                            <CheckBox x:Name="SensorBarBox" Content="Turn the IR sensor bar on when the stream starts" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="Layout and start options apply the next time the stream starts (or on Reset)." Margin="2,0,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Audio ============ -->
            <ScrollViewer x:Name="PageAudio" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,24,28,24" MaxWidth="980">
                    <TextBlock Text="Audio" Style="{StaticResource PageTitle}" />
                    <Border CornerRadius="8" Padding="16,11" Margin="0,0,0,12" BorderThickness="1"
                            Background="#22D29922" BorderBrush="#66D29922">
                        <DockPanel>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="16" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Known issue: the GamePad's speakers are currently silent, even though PC sound is being captured and sent. This setting picks what is captured; it won't make sound play yet." />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sound source" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="The Windows playback device whose sound goes to the GamePad (loopback: you only hear apps playing to that device)." />
                            <ComboBox x:Name="AudioBox" SelectionChanged="Setting_Changed" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="Changes apply the next time the stream starts (or on Reset)." Margin="2,0,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Advanced ============ -->
            <ScrollViewer x:Name="PageAdvanced" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="24,24,28,24" MaxWidth="980">
                    <TextBlock Text="Advanced" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Radio" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="5 GHz channel and data rate of the GamePad link. Tested: channel 161 at 54 Mbit/s." />
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="Channel" Style="{StaticResource TileLabel}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="ChannelBox" Width="140" SelectionChanged="Setting_Changed" />
                                </StackPanel>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="Data rate (Mbit/s)" Style="{StaticResource TileLabel}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="RateBox" Width="140" SelectionChanged="Setting_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Wi-Fi card" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Runs tools\wifi-mode.ps1: which driver the MT7925 uses, plus the Bluetooth/Ethernet health check. Switching only touches the Wi-Fi card and needs the stream stopped." />
                            <WrapPanel>
                                <Button x:Name="WifiStatusButton" Click="WifiStatus_Click" Padding="14,7" Margin="0,0,8,8" Content="Check status" />
                                <Button x:Name="WifiNormalButton" Click="WifiNormal_Click" Padding="14,7" Margin="0,0,8,8" Content="Switch to normal Wi-Fi" />
                                <Button x:Name="WifiGamePadButton" Click="WifiGamePad_Click" Padding="14,7" Margin="0,0,8,8" Content="Switch to GamePad mode" />
                            </WrapPanel>
                            <TextBox x:Name="WifiOutput" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     MaxHeight="260" Visibility="Collapsed" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="App" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="CloseToTrayBox" Content="Closing the window keeps ZiiUScreen running in the notification area"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,4,0,10" />
                            <WrapPanel>
                                <Button Click="OpenRepo_Click" Padding="14,7" Margin="0,0,8,0" Content="Open repo folder" />
                            </WrapPanel>
                            <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Logs ============ -->
            <DockPanel x:Name="PageLogs" Visibility="Collapsed" Margin="24,24,28,24">
                <TextBlock DockPanel.Dock="Top" Text="Logs" Style="{StaticResource PageTitle}" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <ComboBox x:Name="LogBox" Width="240" SelectionChanged="LogBox_SelectionChanged" />
                    <CheckBox x:Name="LogFollow" Content="Follow" IsChecked="True" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Click="OpenLogs_Click" Padding="12,6" Content="Open folder" HorizontalAlignment="Right" />
                    <Button DockPanel.Dock="Right" Click="RefreshLog_Click" Padding="12,6" Margin="0,0,8,0" Content="Refresh" HorizontalAlignment="Right" />
                    <Border />
                </DockPanel>
                <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
